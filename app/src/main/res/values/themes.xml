<resources>
    <color name="ic_launcher_background">#17181B</color>
    <color name="window_bg">#0F1012</color>

    <style name="Theme.SchoolDay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch screen: same dark background and icon the startup animation begins with. -->
    <style name="Theme.SchoolDay.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SchoolDay</item>
    </style>
</resources>
